#cloud-config
hostname: ${hostname}
fqdn: ${hostname}.${dns_domain}
preserve_hostname: false

%{ if install_base_packages ~}
package_update: true
packages:
  - curl
  - jq
  - python3
%{ endif ~}

write_files:
  - path: /usr/local/bin/oci-instance-label.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -uo pipefail
      MD=$(curl -sf --max-time 5 -H "Authorization: Bearer Oracle" \
             http://169.254.169.254/opc/v2/instance/) || exit 0
      command -v jq >/dev/null || exit 0
      {
        echo "INSTANCE_ID=$(jq -r '.id // ""' <<<"$MD")"
        echo "INSTANCE_NAME=$(jq -r '.displayName // ""' <<<"$MD")"
        echo "SHAPE=$(jq -r '.shape // ""' <<<"$MD")"
        echo "AD=$(jq -r '.availabilityDomain // ""' <<<"$MD")"
        echo "FD=$(jq -r '.faultDomain // ""' <<<"$MD")"
        echo "REGION=$(jq -r '.canonicalRegionName // ""' <<<"$MD")"
        echo "ROLE=$(jq -r '.definedTags["${tag_namespace}"].role // "${role}"' <<<"$MD")"
        echo "POOL=$(jq -r '.metadata["${tag_namespace}_pool"] // "stable"' <<<"$MD")"
        echo "RELEASE=$(jq -r '.metadata["${tag_namespace}_release"] // "unknown"' <<<"$MD")"
      } > /run/instance.env
      chmod 0644 /run/instance.env

runcmd:
  - [ /usr/local/bin/oci-instance-label.sh ]
  - [ bash, -c, "iptables -I INPUT 1 -p tcp --dport ${allow_port} -j ACCEPT || true" ]
  - [ bash, -c, "netfilter-persistent save || true" ]
  - [ bash, -c, "systemctl restart fluent-bit || true" ]
