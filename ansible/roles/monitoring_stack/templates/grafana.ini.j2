# {{ ansible_managed }}
[log]
mode = file
level = info

[log.file]
log_rotate = true
max_days = 7

[security]
disable_gravatar = true
cookie_secure = false
content_security_policy = true

[users]
allow_sign_up = false

[auth.anonymous]
enabled = false

[analytics]
reporting_enabled = false
check_for_updates = false
