# {{ ansible_managed }}
[Unit]
Description=Fluent Bit (log and metrics agent)
After=network-online.target oci-instance-label.service
Wants=network-online.target
# The identity file is where INSTANCE_NAME, FD and ROLE come from -- the
# labels on every metric and log line. Without it the agent starts and ships
# unlabelled data, which is worse than not starting.
Requires=oci-instance-label.service

[Service]
User=fluent-bit
Group=systemd-journal
# adm: needed to read /var/log/nginx/*.log (0640 root:adm). Without it the
# tail inputs fail with permission denied and the access-rate metrics are
# simply absent.
SupplementaryGroups=adm
Restart=always
RestartSec=5

# /run/instance.env is written by oci-instance-label.service, which runs as
# root before this unit. It is NOT written here: this unit runs as
# fluent-bit, which cannot overwrite a root-owned file in /run -- an
# ExecStartPre that tried would fail the start on every reboot after the
# first.
EnvironmentFile=/run/instance.env
ExecStartPre=/usr/bin/mkdir -p {{ fluentbit_state_dir }}/storage
ExecStart=/opt/fluent-bit/bin/fluent-bit -c {{ fluentbit_config_dir }}/fluent-bit.yaml

# Capped so a monitoring outage -- when the buffers fill -- cannot push the
# applications into reclaim.
MemoryMax={{ fluentbit_memory_max }}
CPUQuota={{ fluentbit_cpu_quota }}

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths={{ fluentbit_state_dir }} {{ fluentbit_textfile_dir }}

[Install]
WantedBy=multi-user.target
