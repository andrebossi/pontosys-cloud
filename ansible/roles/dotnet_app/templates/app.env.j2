# {{ ansible_managed }}
{% set name = item.key %}
{% set app = item.value %}
# {{ app.description | default(name) }} -- secrets, 0640 root:{{ app_deploy_user }}
#
# Kestrel binds loopback only. The public entrance is nginx; a port reachable
# from the network would bypass the access log, the rate limits and the
# request id.
ASPNETCORE_URLS=http://127.0.0.1:{{ app.port }}
ASPNETCORE_ENVIRONMENT=Production
{% for cs_name, server_key in (app.connections | default({})).items() %}
{% set db = db_servers[server_key] %}
ConnectionStrings__{{ cs_name }}=server={{ db.host }};port={{ db.port }};database={{ db.database }};user={{ db.username }};password={{ db.password }};{{ db_connection_options | trim }}
{% endfor %}
{% for k, v in (app_secrets_common | combine(app_secrets[name] | default({}))).items() %}
{{ k }}={{ v }}
{% endfor %}
