# {{ ansible_managed }}
{% set app = item.item %}
{% set cred = item.secret_bundle.secret_bundle_content.content | b64decode | from_json %}
APP_DLL={{ applications[app].dll | default(app ~ '.dll') }}
ASPNETCORE_URLS=http://127.0.0.1:{{ applications[app].listen_port }}
ASPNETCORE_ENVIRONMENT=Production

ConnectionStrings__Default=Server={{ cred.host }};Port={{ cred.port }};Database={{ cred.database }};User ID={{ cred.username }};Password={{ cred.password }};
{#
  Application pool sized BELOW the server's max_connections.
  2 instances x 2 applications x 30 = 120 connections worst case, against
  max_connections=150 -- leaves headroom for the exporter and for an
  administrative session. Leaving the driver default (100 per pool) would
  give 400 and the database would refuse connections right at peak.
#}
ConnectionStrings__Default__MaximumPoolSize={{ app_db_pool_max }}

Logging__Console__FormatterName=json
Logging__Console__FormatterOptions__UseUtcTimestamp=true
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
