# {{ ansible_managed }}
{% set app = item.value %}
# {{ app.description | default(item.key) }}
#
# 0640 root:{{ app_deploy_user }} -- the only place on the machine a password
# appears. Every value comes from OCI Vault at converge time; `secret_values`
# is keyed by the short name the catalog uses.
ASPNETCORE_URLS=http://127.0.0.1:{{ app.port }}
ASPNETCORE_ENVIRONMENT=Production
{% if app.database is defined %}
{% set db = secret_values[app.database.secret] | from_json %}
{% for context, schema in app.database.schemas.items() %}
ConnectionStrings__{{ context }}=server={{ db.host }};port={{ db.port }};database={{ schema }};user={{ db.username }};password={{ db.password }};{{ db_connection_options | trim }}
{% endfor %}
{% endif %}
{% for var, name in (app.secrets | default({})).items() %}
{{ var }}={{ secret_values[name] }}
{% endfor %}
