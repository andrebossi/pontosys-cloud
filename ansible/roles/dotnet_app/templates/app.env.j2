# {{ ansible_managed }}
{% set name = item.key %}
{% set app = item.value %}
# {{ app.description | default(name) }}
#
# Written as a template. `pscloud env` resolves the @@names@@ from the vault --
# on a converge, and again at boot on a machine nobody converged. No credential
# is ever in this repository, in an image, or in a fact.
ASPNETCORE_URLS=http://127.0.0.1:{{ app.port }}
ASPNETCORE_ENVIRONMENT=Production
{% for cs_name, server_key in (app.connections | default({})).items() %}
{% set db = db_servers[server_key] %}
ConnectionStrings__{{ cs_name }}=server={{ db.host }};port={{ db.port }};database={{ db.database }};user={{ db_user_prefix }}{{ name }};password=@@{{ secret_prefix }}-db-{{ db_user_prefix }}{{ name }}@@;{{ db_connection_options | trim }}
{% endfor %}
{% for var, ref in (app_secret_refs[name] | default({})).items() %}
{{ var }}=@@{{ ref }}@@
{% endfor %}
