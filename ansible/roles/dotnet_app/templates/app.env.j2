# {{ ansible_managed }}
{% set name = item.key %}
{% set app = item.value %}
# {{ app.description | default(name) }} -- secrets, 0640 root:{{ app_deploy_user }}
#
# Kestrel binds loopback only. A port reachable from the network would bypass
# the access log, the timeouts and the request id.
ASPNETCORE_URLS=http://127.0.0.1:{{ app.port }}
ASPNETCORE_ENVIRONMENT=Production
{% for cs_name, server_key in (app.connections | default({})).items() %}
{% set db = db_servers[server_key] %}
ConnectionStrings__{{ cs_name }}=server={{ db.host }};port={{ db.port }};database={{ db.database }};user={{ db_user_prefix }}{{ name }};password={{ db_app_passwords[name] }};{{ db_connection_options | trim }}
{% endfor %}
{% for var, secret in (app_secret_refs[name] | default({})).items() %}
{{ var }}={{ app_secret_values[secret] }}
{% endfor %}
