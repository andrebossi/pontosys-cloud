# {{ ansible_managed }}
{% set app = item.value %}
{% set home = app_deploy_root ~ '/' ~ item.key %}
[Service]
# The template unit has no ExecStart: systemd will not expand a variable into
# the executable path, so it has to be literal and per application.
ExecStart={{ dotnet_root }}/dotnet {{ home }}/current/{{ app.dll }}
Environment=DOTNET_ROOT={{ dotnet_root }}
# OpenSSL 1.1, staged privately rather than installed system-wide.
Environment=LD_LIBRARY_PATH={{ dotnet_compat_dir }}/lib
# .NET 5 only probes libicuuc.so up to 67; this host has {{ dotnet_host_icu_version }}.
# A 2.1 application ignores this -- the variable arrived in .NET Core 3.0.
Environment=CLR_ICU_VERSION_OVERRIDE={{ dotnet_host_icu_version }}
{% for k, v in dotnet_runtime_env.items() %}
Environment={{ k }}={{ v }}
{% endfor %}

# ProtectSystem=strict makes the filesystem read-only. These are the only paths
# the application may write, and the ones that survive a release.
ReadWritePaths={{ home }}/shared
