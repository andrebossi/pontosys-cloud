# {{ ansible_managed }}
{% set t = app_tiers[item.value.tier] %}
# tier: {{ item.value.tier }}
[Service]
# MemoryHigh is SOFT: crossing it makes the kernel throttle the process and
# apply reclaim pressure, which is the window where the .NET GC can still
# react. MemoryMax is HARD and crossing it is an OOM kill. The gap between
# them is the margin.
MemoryMin={{ item.value.memory_min | default(t.memory_min) }}
MemoryHigh={{ item.value.memory_high | default(t.memory_high) }}
MemoryMax={{ item.value.memory_max | default(t.memory_max) }}
MemorySwapMax={{ item.value.memory_swap_max | default(t.memory_swap_max) }}

# CPUQuota is not optional: without it the kernel never fills throttled_usec
# in cpu.stat and the throttling metric stays at zero forever.
CPUQuota={{ item.value.cpu_quota | default(t.cpu_quota) }}
# CPUWeight decides who wins a contended core. This is the directive that
# keeps report rendering out of the way of payments.
CPUWeight={{ item.value.cpu_weight | default(t.cpu_weight) }}
IOWeight={{ item.value.io_weight | default(t.io_weight) }}
