# {{ ansible_managed }}
#
# Template unit: one instance per application, named by the catalog key.
# Everything specific to an application -- which runtime, which assembly,
# what it may write -- is in the 10-runtime.conf drop-in, and every ceiling
# is in 20-limits.conf. Nothing here needs editing to add an app.
[Unit]
Description=.NET application (%i)
Documentation=file://{{ app_deploy_root }}/%i
After=network-online.target
Wants=network-online.target
# An application that was never deployed has no `current` symlink. The assert
# fails the start cleanly instead of producing a crash loop whose journal says
# only "file not found".
AssertPathExists={{ app_deploy_root }}/%i/current
# On a machine nobody converged -- a pool member -- the env file is written at
# boot from the vault. Without this the unit races it and fails on a missing
# EnvironmentFile.
After=pscloud-env.service

# Default is 5 starts in 10s, after which systemd gives up FOREVER. An app
# that is down because the database is unreachable would stay dead long after
# the database came back. Disabled here; the backoff below is what prevents
# the tight loop.
StartLimitIntervalSec=0

[Service]
Type={{ app_systemd_type }}
User={{ app_deploy_user }}
Group={{ app_deploy_user }}
Slice=apps.slice

WorkingDirectory={{ app_deploy_root }}/%i/current
EnvironmentFile={{ app_config_dir }}/%i.env
ExecReload=/bin/kill -HUP $MAINPID

Restart=always
RestartSec=2
RestartSteps=6
RestartMaxDelaySec=120

TimeoutStartSec=60
TimeoutStopSec=30
# SIGTERM lets Kestrel finish in-flight requests; anything still running after
# TimeoutStopSec is killed. `mixed` sends the TERM to the main process only,
# so a child dotnet process cannot be orphaned.
KillSignal=SIGTERM
KillMode=mixed

# Accounting always on: this is what fills cpu.stat and memory.events, which
# the cgroup exporter turns into per-app throttling and OOM metrics. The
# CEILINGS live in 20-limits.conf, never here.
MemoryAccounting=yes
CPUAccounting=yes
IOAccounting=yes
TasksAccounting=yes

# If the OOM killer catches any process in the cgroup, kill the whole cgroup
# and let Restart=always bring it back clean. `continue` would leave the app
# half-alive, answering 500s, with nothing obviously wrong.
OOMPolicy=kill

TasksMax=192
LimitNOFILE=65535

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dotnet-%i
LogExtraFields=APP=%i

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
# AF_NETLINK is in the list because .NET enumerates network interfaces over
# netlink; without it the app throws on startup.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# DO NOT turn this on: the JIT needs pages that are writable and then
# executable, and the app dies on the first compiled method.
MemoryDenyWriteExecute=no

StateDirectory=dotnet-dumps

[Install]
WantedBy=multi-user.target
