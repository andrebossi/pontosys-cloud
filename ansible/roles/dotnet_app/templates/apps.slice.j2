# {{ ansible_managed }}
[Unit]
Description=.NET applications
Before=slices.target

# The ceiling for the GROUP. Each app has its own limit; this is what stops
# {{ applications | length }} of them, each inside its own limit, from adding up to more than
# the {{ (host_memory_mb / 1024) | round(1) }} GB this VM has.
#
# It is also the collection's identity: Fluent Bit's systemd input filters on
# _SYSTEMD_SLICE=apps.slice, and the cgroup exporter walks
# /sys/fs/cgroup/apps.slice/dotnet-app@*.service. An app started outside this
# slice runs, but is invisible.

[Slice]
MemoryAccounting=yes
MemoryHigh={{ apps_slice_memory_high }}
MemoryMax={{ apps_slice_memory_max }}
MemorySwapMax={{ apps_slice_memory_swap_max }}

CPUAccounting=yes
CPUQuota={{ apps_slice_cpu_quota }}
CPUWeight=100

IOAccounting=yes
IOWeight=100
TasksMax=2048
