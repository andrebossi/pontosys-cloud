# {{ ansible_managed }}
#
# {{ host_vcpus }} vCPU, {{ (host_memory_mb / 1024) | round(1) }} GB. nginx here is a reverse proxy in front of
# {{ applications | length }} loopback Kestrel processes plus the static bundles -- it terminates
# no TLS (the load balancer does) and reads no large files off disk.

user {{ nginx_user }};
worker_processes {{ nginx_worker_processes }};
worker_rlimit_nofile {{ nginx_worker_rlimit_nofile }};
pid /run/nginx.pid;
error_log {{ nginx_error_log }} {{ nginx_error_log_level }};

include /usr/share/nginx/modules/*.conf;

events {
    worker_connections {{ nginx_worker_connections }};
    # Accept every pending connection on a wake-up instead of one at a time.
    # With 2 workers and a load balancer opening keepalive connections in
    # bursts, one-at-a-time leaves connections queued for no reason.
    multi_accept on;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # ------------------------------------------------------------------
    # LOGGING
    #
    # One JSON line per request, matching the `nginx_json` parser in
    # observability_agent. $app_name is what makes per-application alerting
    # possible -- without it the {{ applications | length }} apps collapse into one metric.
    #
    # request_time is emitted UNQUOTED so it is a number to Fluent Bit's
    # log_to_metrics histogram; upstream_response_time is quoted because it
    # can be empty or comma-separated when more than one upstream was tried.
    # ------------------------------------------------------------------
    log_format json_analytics escape=json
      '{'
        '"t":"$time_iso8601",'
        '"app":"$app_name",'
        '"remote_addr":"$remote_addr",'
        '"method":"$request_method",'
        '"uri":"$uri",'
        '"query":"$query_string",'
        '"status":"$status",'
        '"body_bytes":$body_bytes_sent,'
        '"request_time":$request_time,'
        '"upstream_time":"$upstream_response_time",'
        '"upstream_addr":"$upstream_addr",'
        '"upstream_status":"$upstream_status",'
        '"host":"$host",'
        '"user_agent":"$http_user_agent",'
        '"xff":"$http_x_forwarded_for",'
        '"request_id":"$request_id"'
      '}';

    # buffer=32k flushes in batches instead of a write() per request; flush=5s
    # bounds how long a line can sit unwritten, which is what keeps the tail
    # input from going quiet on a low-traffic night.
    access_log {{ nginx_access_log }} json_analytics buffer=32k flush=5s;

    # ------------------------------------------------------------------
    # CONNECTION HANDLING
    # ------------------------------------------------------------------
    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;

    # 65s matches the OCI load balancer's default idle timeout. Shorter here
    # and the balancer reuses a connection nginx has already closed, which
    # surfaces as sporadic 502s with nothing in the error log.
    keepalive_timeout  65;
    keepalive_requests 1000;

    client_body_timeout   30s;
    client_header_timeout 15s;
    send_timeout          60s;
    reset_timedout_connection on;

    # A JWT in an Authorization header overflows the default 8k and nginx
    # answers 400 before the request ever reaches Kestrel. Carried over from
    # the previous machine, where it was set for exactly this.
    large_client_header_buffers {{ nginx_large_client_header_buffers }};

    types_hash_max_size 4096;
    server_tokens off;

    # ------------------------------------------------------------------
    # PROXY BUFFERING
    #
    # On by default and left on: it lets a slow client drain a report at its
    # own pace while the Kestrel worker is already free. Buffers sized for
    # JSON responses; anything larger spills to disk, which is the right
    # trade on a box where memory is the scarce resource.
    # ------------------------------------------------------------------
    proxy_buffering       on;
    proxy_buffer_size     16k;
    proxy_buffers         8 16k;
    proxy_busy_buffers_size 32k;
    proxy_temp_file_write_size 64k;
    proxy_max_temp_file_size 256m;
    proxy_request_buffering on;

{% if nginx_gzip.enabled | default(false) %}
    # ------------------------------------------------------------------
    # COMPRESSION
    #
    # The Flutter and Ionic bundles are megabytes of JavaScript and WASM;
    # this is the largest single improvement available to first paint.
    # Level {{ nginx_gzip.comp_level }} is where the CPU/ratio curve flattens -- higher costs
    # measurable CPU on a 2 vCPU box for a percent or two of size.
    # ------------------------------------------------------------------
    gzip              on;
    gzip_vary         on;
    gzip_proxied      any;
    gzip_comp_level   {{ nginx_gzip.comp_level }};
    gzip_min_length   {{ nginx_gzip.min_length }};
    gzip_types        {{ nginx_gzip.types | join(' ') }};
{% endif %}

    # Static assets are immutable within a release, so caching their
    # descriptors removes an open()/stat() per request.
    open_file_cache {{ nginx_open_file_cache }};
    open_file_cache_valid 60s;
    open_file_cache_min_uses 2;
    open_file_cache_errors off;

    # Long server names with the hash bucket default (32) overflow at startup.
    server_names_hash_bucket_size 128;

    # ------------------------------------------------------------------
    # HEADER MAPS
    # ------------------------------------------------------------------
    # Upstream keepalive needs `Connection: ""`, a WebSocket needs
    # `Connection: upgrade`. Hardcoding either one breaks the other: with
    # "keep-alive" -- what the previous machine sent -- SignalR silently falls
    # back to long polling. The map picks per request.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      '';
    }

    # The load balancer sets X-Forwarded-Proto, but a direct call from inside
    # the VCN does not. Passing it through empty makes the app build "://..."
    # URLs; falling back to $scheme keeps them well formed.
    map $http_x_forwarded_proto $forwarded_proto {
        default $http_x_forwarded_proto;
        ''      $scheme;
    }

    # The per-application log label, derived from $request_uri rather than set
    # inside each location. It has to be a map: `set` runs in the rewrite
    # phase, and error_page performs an INTERNAL REDIRECT to /50x.html, which
    # re-enters the rewrite phase in a different location and resets the
    # value. Every 502 would then be logged as "static" -- which is precisely
    # the line the per-application 5xx alert depends on. $request_uri keeps
    # the original request, untouched by internal redirects.
    map $request_uri $app_name {
        default "static";
{% for name, app in applications.items() %}
        ~^{{ app.path }}($|[/?])  "{{ name }}";
{% endfor %}
{% for name, site in static_sites.items() if site.path != '/' %}
        ~^{{ site.path }}($|[/?]) "{{ name }}";
{% endfor %}
    }

    include /etc/nginx/conf.d/*.conf;
}
