{% set peers = (groups['role_app'] | default([])) | difference([inventory_hostname]) %}
upstreams:
{% for name, app in applications.items() %}
  - name: {{ name }}_up
    servers:
      - address: 127.0.0.1:{{ app.listen_port }}
        max_fails: {{ app_upstream_max_fails }}
        fail_timeout: {{ app_upstream_fail_timeout }}
{% if app_peer_failover | bool and name not in app_peer_failover_exclude %}
{% for peer in peers %}
      - address: {{ peer }}:{{ app.listen_port }}
        backup: true
        max_fails: {{ app_upstream_max_fails }}
        fail_timeout: {{ app_upstream_fail_timeout }}
{% endfor %}
{% endif %}
    keepalive: 16
{% endfor %}

servers:
  - core:
      listen:
        - port: {{ app_backend_port }}
          default_server: true
      server_name: _
    custom_directives:
      - set $app_name "_";
    log:
      access:
        - path: {{ nginx_access_log }}
          format: json_analytics
    locations:
      - location: = /healthz
        custom_directives:
          - access_log off;
          - add_header Content-Type text/plain;
          - return 200 "ok\n";
      - location: = /readyz
        custom_directives:
          - access_log off;
        proxy:
          pass: http://{{ readyz_app }}_up/healthz
          connect_timeout: 2s
          read_timeout: 5s
      - location: /
        custom_directives:
          - return 444;

{% for name, app in applications.items() %}
{% set t = app_nginx_tiers[app.tier] %}
  - core:
      listen:
        - port: {{ app_backend_port }}
      server_name: {{ app.server_names | join(' ') }}
      client_max_body_size: {{ t.client_max_body_size }}
    custom_directives:
      - set $app_name "{{ name }}";
    log:
      access:
        - path: {{ nginx_access_log }}
          format: json_analytics
    locations:
      - location: = /healthz
        custom_directives:
          - access_log off;
          - return 200 "ok\n";
      - location: /
        proxy:
          pass: http://{{ name }}_up
          http_version: '1.1'
          set_header:
            - field: Connection
              value: '""'
            - field: Host
              value: $host
            - field: X-Real-IP
              value: $remote_addr
            - field: X-Forwarded-For
              value: $proxy_add_x_forwarded_for
            - field: X-Forwarded-Proto
              value: $http_x_forwarded_proto
            - field: X-Forwarded-Host
              value: $host
            - field: X-Request-Id
              value: $request_id
          connect_timeout: {{ t.connect_timeout }}
          send_timeout: {{ t.read_timeout }}
          read_timeout: {{ t.read_timeout }}
          # non_idempotent is left out: resending a POST that already reached
          # Kestrel would duplicate a sale or payment request.
          next_upstream: [error, timeout, http_502, http_503, http_504]
          next_upstream_tries: 2
          next_upstream_timeout: {{ t.connect_timeout }}
{% endfor %}
