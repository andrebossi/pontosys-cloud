# Terraform / Terragrunt (autentica como você, com API key)
export TF_VAR_tenancy_ocid=ocid1.tenancy.oc1..xxx
export TF_VAR_user_ocid=ocid1.user.oc1..xxx
export TF_VAR_fingerprint=aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99
export TF_VAR_private_key_path=$HOME/projects/pscloud/keys/you@example.com-private.pem
export TG_TF_PATH=terraform

# Imagem Packer para o pool das apps. Vazio = Ubuntu da plataforma.
export PSCLOUD_APP_IMAGE_ID=

# Ansible: onde estão compartimento, vault e chave (terragrunt output em infra/live/prod/platform)
export OCI_COMPARTMENT_OCID=ocid1.tenancy.oc1..xxx
export OCI_VAULT_OCID=ocid1.vault.oc1.sa-saopaulo-1.xxx
export OCI_VAULT_KEY_OCID=ocid1.key.oc1.sa-saopaulo-1.xxx

# IP público do monitoring (terragrunt output public_ips em infra/live/prod/monitoring)
export MONITORING_IP=
export MONITORING_SSH_KEY="priv-key-path"