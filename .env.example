# pscloud — environment
#
#   cp keys/.env.example keys/.env
#   # fill it in
#   source keys/.env
#
# keys/ is gitignored except for this example. Nothing here is read from a
# file automatically: every command below assumes the shell has been sourced.
#
# Two consumers, and they are separate on purpose:
#
#   Terraform/Terragrunt   authenticates as YOU, with an API key, to build
#                          infrastructure.
#   Ansible + pscloud      authenticates as the MACHINE (instance principal)
#                          in OCI. These variables only tell it which
#                          compartment, vault and bucket to look at -- except
#                          on a local VM, which has no instance principal and
#                          borrows ~/.oci/config instead.


# ---------------------------------------------------------------------------
# TERRAFORM / TERRAGRUNT
#
# The OCI provider reads TF_VAR_tenancy_ocid, TF_VAR_user_ocid,
# TF_VAR_fingerprint and TF_VAR_private_key_path on its own -- which is why
# the generated provider.tf only sets the region.
# ---------------------------------------------------------------------------

export TF_VAR_tenancy_ocid=ocid1.tenancy.oc1..xxx
export TF_VAR_user_ocid=ocid1.user.oc1..xxx
export TF_VAR_fingerprint=aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99
export TF_VAR_private_key_path=/home/andre/projects/pscloud/keys/you@example.com-private.pem

# Terragrunt defaults to `tofu`, and OpenTofu has no `oci` backend. Without
# this, `terragrunt run --all apply` fails on the backend block, not on OCI.
export TG_TF_PATH=terraform

# Boot the instance pool from a Packer image instead of the newest Ubuntu
# platform image. Empty is valid and means "platform image".
#   read by: infra/live/prod/app-tier/terragrunt.hcl
export PSCLOUD_APP_IMAGE_ID=

# The monitoring host has no Packer build yet (image.yml only bakes the app
# tier's roles), so infra/live/prod/monitoring/terragrunt.hcl always boots it
# from the newest Ubuntu platform image -- there is no override var for it,
# unlike PSCLOUD_APP_IMAGE_ID above.


# ---------------------------------------------------------------------------
# ANSIBLE — inventory and the pscloud CLI
#
# These three become PSCLOUD_COMPARTMENT, PSCLOUD_VAULT and PSCLOUD_VAULT_KEY
# inside /usr/local/bin/pscloud on every machine, through group_vars/all.yml.
#
# The wrapper is generated at converge time and the values are baked into it,
# so after changing any of them re-run:  ansible-playbook site.yml --tags cli
# ---------------------------------------------------------------------------

# Which compartment the dynamic inventory queries, and where secrets live.
#   read by: inventory/oci.yml, group_vars/all.yml -> PSCLOUD_COMPARTMENT
#   value:   locals.compartment_id in infra/live/<env>/env.hcl
export OCI_COMPARTMENT_OCID=ocid1.tenancy.oc1..xxx

# The vault `pscloud secret` reads from and writes to. Leave these empty and
# `pscloud env` fails with
#   InvalidParameter: query param vaultId size must be between 1 and 255
# which is the API's way of saying the variable was an empty string.
#   read by: group_vars/all.yml -> PSCLOUD_VAULT / PSCLOUD_VAULT_KEY
#   value:   terragrunt output from infra/live/<env>/platform
export OCI_VAULT_OCID=ocid1.vault.oc1.sa-saopaulo-1.xxx

# The KMS key new secrets are encrypted with. Only needed to CREATE a secret;
# reading an existing one does not use it.
export OCI_VAULT_KEY_OCID=ocid1.key.oc1.sa-saopaulo-1.xxx


# ---------------------------------------------------------------------------
# ANSIBLE — database
#
# The MySQL DB System is private and unreachable from where Terraform runs, so
# schemas and accounts are created by roles/db_users from an application VM.
# ---------------------------------------------------------------------------

# One host for every schema; db_servers in group_vars/role_app/config.yml
# points both `global` and `cep` at it.
#   read by: group_vars/role_app/config.yml, group_vars/env_local.yml
#   value:   the DB system's private DNS name, e.g.
#            pscloudmysql.db.vcn.oraclevcn.com
export PSCLOUD_DB_HOST=

# The account roles/db_users connects as to create the per-application ones.
# Its PASSWORD is deliberately not here: it comes from the vault, via
# `pscloud secret`. Defaults to `admin` when unset.
export PSCLOUD_DB_ADMIN_USER=admin


# ---------------------------------------------------------------------------
# NOT SET HERE
#
# PSCLOUD_BUCKET      derived from label_prefix in group_vars/all.yml
#                     (pscloud-releases) and baked into the CLI wrapper.
# PSCLOUD_APP_GROUP   defaults to `dotnetapp` in pscloud.py; only override it
#                     if the service account is renamed.
# database passwords  generated on first run by roles/db_users and stored in
#                     the vault. They are never typed anywhere.
# GITHUB_TOKEN        only if you deploy straight from a private GitHub
#                     release instead of the bucket.
# ---------------------------------------------------------------------------
